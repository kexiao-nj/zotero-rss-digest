{
  "manifest_version": 2,
  "name": "RSS Digest",
  "version": "0.2.17",
  "description": "Scan Zotero RSS feeds, distill relevant papers, and save selected items to your library.",
  "homepage_url": "https://github.com/kexiao-nj/zotero-rss-digest",
  "author": "kexiao",
  "icons": {
    "48": "content/icon.png",
    "96": "content/icon@2x.png"
  },
  "applications": {
    "zotero": {
      "id": "rss-digest@zotero-rss-analyzer.local",
      "update_url": "https://raw.githubusercontent.com/kexiao-nj/zotero-rss-digest/main/plugin/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
